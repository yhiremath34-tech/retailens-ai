# ==============================================================================
# RetaiLens AI — Environment Configuration
# Copy to .env.local for local development or configure in Vercel Dashboard
# ==============================================================================

# --- Supabase (Optional in Simulation Mode; Required for Connected DB/Auth) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- AI Agent LLM (Optional; Falls back to deterministic ReAct planner if unset) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Computer Vision FastAPI Microservice ---
VISION_SERVICE_URL=http://127.0.0.1:8000
VISION_SERVICE_API_KEY=

# --- Session Signing Secret (Required in production; auto-dev fallback locally) ---
RETAILENS_AUTH_SECRET=change-this-to-a-32-char-random-secret-in-production

# --- Optional Google OAuth via Supabase ---
NEXT_PUBLIC_ENABLE_GOOGLE_AUTH=false

